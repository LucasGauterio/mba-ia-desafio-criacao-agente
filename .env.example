# Configuração do Modelo e Provedor (Google AI Studio)
GOOGLE_API_KEY=
GEMINI_API_KEY=
AURORA_MODEL_NAME=gemini-2.5-flash

# Configurações do Servidor HTTP
AURORA_HOST=0.0.0.0
AURORA_PORT=8000
AURORA_RELOAD=false

# Configurações de Armazenamento e Banco de Dados (SQLite)
AURORA_DB_PATH=./storage/aurora.db
AURORA_DADOS_DIR=./dados
